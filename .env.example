# ---------------------------------------------------------------------------
# Environment variables for watts-your-impact (wyi-landing)
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# In production (Netlify), set these in Site settings > Environment variables.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; the rest are
# server-only. Never commit real secrets — only this example is tracked.
# ---------------------------------------------------------------------------

# --- YouTube ---------------------------------------------------------------

# The channel id (starts with "UC..."). Required for both the RSS feed and the
# Data API. Exposed to the client (NEXT_PUBLIC_).
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# YouTube Data API v3 key. When set, the site fetches the FULL episode
# catalogue via the Data API instead of the RSS feed (RSS is capped at the 15
# most recent uploads). Get one for free from the Google Cloud Console:
#   1. Create/select a project
#   2. Enable "YouTube Data API v3"
#   3. Create credentials > API key
# Leave blank to keep running on the RSS feed.
YOUTUBE_API_KEY=

# Optional: override the RSS feed URL used as the fallback. If unset, it is
# derived from NEXT_PUBLIC_YOUTUBE_CHANNEL_ID automatically.
# YOUTUBE_RSS_URL=https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxxxxxxxxxxxxxxxxxxx

# --- Spotify (optional) ----------------------------------------------------
# Used to enrich episodes with matching Spotify links. If both client values
# are absent, Spotify enrichment is simply skipped.

# Spotify app Client ID & Secret (from https://developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The Spotify show/podcast id. Exposed to the client (NEXT_PUBLIC_).
NEXT_PUBLIC_SPOTIFY_SHOW_ID=
